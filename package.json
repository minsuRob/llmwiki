{
  "name": "llmwiki",
  "private": true,
  "description": "Aria 구조를 옮긴 할일 비서 — 앱(aria-rn) · API(functions) · 공용 로직(packages/core) · Firebase",
  "scripts": {
    "test:core": "npm --prefix packages/core test",
    "build:functions": "npm --prefix functions run build",
    "emulators": "npm run build:functions && firebase emulators:start --project llmwiki-minsu",
    "test:api": "npm run build:functions && firebase emulators:exec --only auth,firestore,functions --project llmwiki-minsu \"node --test tests/api.test.mjs\"",
    "test": "npm run test:core && npm run test:functions && npm run test:api",
    "test:functions": "npm --prefix functions test",
    "test:cloud": "bash tests/cloud-smoke.sh",
    "deploy": "firebase deploy --only hosting,functions,firestore --project llmwiki-minsu",
    "deploy:web": "firebase deploy --only hosting --project llmwiki-minsu",
    "local-drive": "node tools/local-drive/server.mjs --dir .local-drive --port 8790 --seed",
    "desktop:install": "npm --prefix desktop install",
    "desktop:start": "npm --prefix desktop start",
    "desktop:dev": "LLMWIKI_DESKTOP_URL=http://localhost:8081 npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "test:desktop": "npm --prefix desktop test",
    "desktop:release": "npm --prefix desktop run release",
    "test:mcp": "node --test tools/llmwiki-mcp/server.test.mjs",
    "mcp": "node tools/llmwiki-mcp/server.mjs"
  },
  "devDependencies": {
    "firebase": "^13.0.0"
  }
}
